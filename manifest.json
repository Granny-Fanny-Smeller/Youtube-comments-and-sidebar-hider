{
  "manifest_version": 3,
  "name": "YouTube Comments & Recommendations Toggle (Edge)",
  "version": "1.1.0",
  "description": "Toggle hiding YouTube comments, sidebars, and recommended videos.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "action": {
    "default_title": "YouTube Clean Switch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "css": [
        "youtube-clean.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "88"
}
